{
  "name": "HugoBlox Codespace",
  "image": "ghcr.io/HugoBlox/hugo-blox-dev:hugo0.162.0",
  "updateContentCommand": "npm ci",
  "postCreateCommand": "npm --version && hugo version && go version",
  "customizations": {
    "vscode": {
      "extensions": [
        "ownable.ownable"
      ]
    }
  },
  "remoteUser": "vscode",
  "forwardPorts": [
    1313
  ],
  "portsAttributes": {
    "1313": {
      "label": "Hugo Server"
    }
  }
}
